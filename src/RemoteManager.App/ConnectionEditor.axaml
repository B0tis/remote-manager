<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="RemoteManager.App.ConnectionEditor"
             Width="460">
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,12,150">
      <TextBox x:Name="NameBox" PlaceholderText="Name" />
      <ComboBox x:Name="TypeBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Content="RDP" />
        <ComboBoxItem Content="TeamViewer" />
        <ComboBoxItem Content="AnyDesk" />
        <ComboBoxItem Content="RustDesk" />
      </ComboBox>
    </Grid>
    <Grid ColumnDefinitions="*,12,90">
      <TextBox x:Name="HostBox" PlaceholderText="Host or IP" />
      <TextBox x:Name="PortBox" Grid.Column="2" PlaceholderText="Port" />
    </Grid>
    <TextBox x:Name="DescriptionBox" PlaceholderText="Description" />
    <Grid ColumnDefinitions="*,12,*">
      <AutoCompleteBox x:Name="GroupBox" PlaceholderText="Group" FilterMode="Contains" MinimumPrefixLength="0" />
      <TextBox x:Name="TagsBox" Grid.Column="2" PlaceholderText="Tags, comma separated" />
    </Grid>

    <TextBlock Text="Logon" FontWeight="SemiBold" Margin="0,6,0,0" />
    <Grid x:Name="UserRow" ColumnDefinitions="*,12,*">
      <TextBox x:Name="UserBox" PlaceholderText="User" />
      <TextBox x:Name="DomainBox" Grid.Column="2" PlaceholderText="Domain (optional)" />
    </Grid>

    <!-- The stored password is never read back into this dialog: the box only takes a new one. -->
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,12,Auto">
        <TextBox x:Name="PasswordBox" PasswordChar="●" PlaceholderText="Passwort" Classes="revealPasswordButton" />
        <CheckBox x:Name="SavePasswordBox" Grid.Column="2" Content="Passwort speichern" />
      </Grid>
      <Grid x:Name="StoredRow" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
        <ui:FASymbolIcon x:Name="StoredIcon" Symbol="Permissions" FontSize="14" Margin="2,0,8,0"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
        <TextBlock x:Name="StoredText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="Passwort gespeichert" />
        <Button x:Name="RemovePasswordButton" Grid.Column="2" Classes="toolbar" Padding="8,2" FontSize="12" Content="Entfernen" />
      </Grid>
      <TextBlock x:Name="PasswordHint" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel x:Name="RdpOptions" Spacing="12">
      <ComboBox x:Name="DisplayBox" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Content="Fit to window (dynamic resolution)" />
        <ComboBoxItem Content="Smart sizing (scaled)" />
        <ComboBoxItem Content="1920 × 1080 (scaled)" />
        <ComboBoxItem Content="1280 × 720 (scaled)" />
      </ComboBox>
      <CheckBox x:Name="WinKeysBox" Content="Send Windows keys (Win, Alt+Tab) to the session" IsChecked="True" />
    </StackPanel>

    <TextBlock x:Name="RemoteToolHint" Opacity="0.55" FontSize="12" TextWrapping="Wrap" IsVisible="False"
               Text="TeamViewer, AnyDesk, and RustDesk sessions open in the tool's own window. Launching them arrives in Phase 2." />

    <CheckBox x:Name="FavoriteBox" Content="Favorite" />
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" IsVisible="False" />
  </StackPanel>
</UserControl>
