<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="RemoteManager.App.App"
             RequestedThemeVariant="Default">
  <!--
    The look lives in Theme/: Palette.axaml (colors per theme, fonts, radii), Controls.axaml (item and button
    templates), Styles.axaml (style classes). The signal color and the chosen theme are applied at runtime by
    Services/Appearance. docs/ui.md describes the design.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Palette.axaml" />
        <ResourceInclude Source="/Theme/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferUserAccentColor="False" />

    <!-- App icon for every window (main, sessions, terminals, dialogs, and any new window). -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/logo.ico" />
    </Style>

    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
