<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="RemoteManager.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <sty:FluentAvaloniaTheme />

    <!-- Small rounded label: status on the tile preview, type badge. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Tile/list switch -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- Tiles: no row chrome, the card itself is the item. -->
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </Application.Styles>
</Application>
