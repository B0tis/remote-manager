<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="RemoteManager.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- App colors that are not in the Fluent palette; everything else uses theme resources. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="FavoriteBrush" Color="#D97706" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="FavoriteBrush" Color="#F59E0B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <sty:FluentAvaloniaTheme />

    <!-- Typography: page title, section subtitle, secondary caption (docs/ui.md). -->
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Icon-only header buttons: one size, no border until hovered. -->
    <Style Selector=":is(Button).icon">
      <Setter Property="Padding" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- A checked icon toggle (detail column) is subtle; the accent stays for the primary action. -->
    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- Narrow header: the primary buttons drop their text and keep icon and tooltip. -->
    <Style Selector="Grid.narrow StackPanel#Toolbar TextBlock.label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Small rounded label: status on the tile preview, type badge. -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#99000000" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Tile/list switch -->
    <Style Selector="Border.segmented">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- Tiles: no row chrome, the card itself is the item. -->
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Overview: group headers, favorite star on tiles, sortable list columns, drop markers. -->
    <Style Selector="Border.count">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style Selector="Border.previewShade">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#66000000" />
          <GradientStop Offset="0.45" Color="#00000000" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBoxItem ui|FASymbolIcon.starOutline">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover ui|FASymbolIcon.starOutline">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.column">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,0,8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.column.sorted">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem.header">
      <Setter Property="Margin" Value="0,4,14,10" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem.header">
      <Setter Property="Margin" Value="0,8,0,2" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.groupHeader">
      <Setter Property="Height" Value="38" />
    </Style>
    <Style Selector="ListBoxItem.dropInto">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0,0,3,0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <!-- Narrow list: below 900 px the group and tag columns give way, below 640 px also "zuletzt". -->
    <Style Selector="Grid.compact :is(Control).wide">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.narrow :is(Control).medium">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.launcher ListBoxItem">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
