<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rdp="using:Devolutions.MsRdpEx.Avalonia"
             x:Class="RemoteManager.App.SessionView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel Spacing="6">
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
          <TextBox x:Name="HostBox" Width="200" PlaceholderText="Host or IP" />
          <TextBox x:Name="UserBox" Width="140" PlaceholderText="User" />
          <TextBox x:Name="DomainBox" Width="120" PlaceholderText="Domain (optional)" />
          <!-- The password only lives in this TextBox until Connect; it is cleared afterwards and never logged. -->
          <TextBox x:Name="PasswordBox" Width="140" PasswordChar="●" PlaceholderText="Password" />
          <ComboBox x:Name="DisplayBox" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="Fit to window (dynamic)" />
            <ComboBoxItem Content="Smart sizing (scaled)" />
            <ComboBoxItem Content="1920 × 1080 (scaled)" />
            <ComboBoxItem Content="1280 × 720 (scaled)" />
          </ComboBox>
          <CheckBox x:Name="NlaBox" Content="NLA" IsChecked="True" IsEnabled="False"
                    ToolTip.Tip="RdpClientView.Connect always enables CredSSP (NLA)." />
          <CheckBox x:Name="KeyboardHookBox" Content="Win keys to session" IsChecked="True"
                    ToolTip.Tip="KeyboardHookMode: send Win, Alt+Tab etc. to the session while it has focus. Applied at connect." />
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
          <Button x:Name="ConnectButton" Content="Connect" Classes="accent" />
          <Button x:Name="DisconnectButton" Content="Disconnect" IsEnabled="False" />
          <Button x:Name="SnapshotButton" Content="Save snapshot" IsEnabled="False" />
          <Button x:Name="FullScreenButton" Content="Fullscreen" IsEnabled="False" />
          <Separator Width="1" Height="24" />
          <!-- Airspace probes: which of these stay visible above a running session? -->
          <Button x:Name="MenuButton" Content="Menu ▾">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Menu item 1 (should overlap the session)" />
                <MenuItem Header="Menu item 2" />
                <MenuItem Header="Menu item 3" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="FlyoutButton" Content="Flyout ▾">
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <Border Width="320" Height="220" Padding="12">
                  <TextBlock TextWrapping="Wrap"
                             Text="Flyout content. If you can read this on top of the remote desktop, popups are native windows above the RDP child HWND." />
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="InWindowDialogButton" Content="ContentDialog (in-window)" />
          <Button x:Name="WindowDialogButton" Content="Dialog (own window)" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" Opacity="0.8" Text="Not connected." TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <Grid>
      <Image x:Name="ThumbnailImage" Stretch="Uniform" IsVisible="False" />
      <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.6" Text="Enter host and credentials, then Connect." />
      <!-- Hidden until Connect: an idle RDP control paints a white rectangle over everything. -->
      <rdp:RdpClientView x:Name="RdpView" IsVisible="False" />
    </Grid>
  </DockPanel>
</UserControl>
