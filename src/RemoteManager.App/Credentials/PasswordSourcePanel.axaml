<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Credentials.PasswordSourcePanel">
  <!-- Where the connection's password comes from. KeePass and 1Password only store a reference; the secret
       is fetched at connect time. -->
  <StackPanel Spacing="8">
    <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectedIndex="0">
      <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_App}" />
      <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_KeePass}" />
      <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_OnePassword}" />
    </ComboBox>

    <StackPanel x:Name="KeePassPanel" Spacing="8" IsVisible="False">
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox x:Name="DatabaseBox" PlaceholderText="{x:Static res:Strings.Vault_KeePass_Database}" />
        <Button x:Name="BrowseDatabaseButton" Grid.Column="2" Content="{x:Static res:Strings.Vault_Browse}" />
      </Grid>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox x:Name="KeyFileBox" PlaceholderText="{x:Static res:Strings.Vault_KeePass_KeyFile}" />
        <Button x:Name="BrowseKeyFileButton" Grid.Column="2" Content="{x:Static res:Strings.Vault_Browse}" />
      </Grid>
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox x:Name="EntryBox" PlaceholderText="{x:Static res:Strings.Vault_KeePass_Entry}" />
        <Button x:Name="PickEntryButton" Grid.Column="2" Content="{x:Static res:Strings.Vault_PickEntry}" />
      </Grid>
      <TextBlock x:Name="KeePassHint" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel x:Name="OnePasswordPanel" Spacing="8" IsVisible="False">
      <TextBox x:Name="OpReferenceBox" PlaceholderText="{x:Static res:Strings.Vault_OnePassword_Reference}" />
      <TextBlock x:Name="OnePasswordMissing" FontSize="12" TextWrapping="Wrap" IsVisible="False"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{x:Static res:Strings.Vault_Err_ToolMissing}" />
      <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap" Text="{x:Static res:Strings.Vault_OnePassword_Hint}" />
    </StackPanel>

    <Grid x:Name="CheckRow" ColumnDefinitions="Auto,8,*" IsVisible="False">
      <Button x:Name="CheckButton" Content="{x:Static res:Strings.Vault_Check}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ui:FASymbolIcon x:Name="CheckIcon" Symbol="Accept" FontSize="14" IsVisible="False"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
        <TextBlock x:Name="CheckText" FontSize="12" TextWrapping="Wrap" MaxWidth="330" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
