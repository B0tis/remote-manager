<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Credentials.PasswordSourcePanel">
  <UserControl.Styles>
    <!-- A check that failed reads as an error, not as a remark. -->
    <Style Selector="TextBlock.failed">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </UserControl.Styles>
  <!-- Where the password comes from. KeePass and 1Password only store a reference; the secret
       is fetched at connect time. The host view puts this panel and its own password box into one well. -->
  <StackPanel Spacing="12">
    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Password_Source}" />
      <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_App}" />
        <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_KeePass}" />
        <ComboBoxItem Content="{x:Static res:Strings.Vault_Source_OnePassword}" />
      </ComboBox>
    </StackPanel>

    <StackPanel x:Name="KeePassPanel" Spacing="12" IsVisible="False">
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vault_KeePass_Database}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="DatabaseBox" Classes="mono" PlaceholderText="{x:Static res:Strings.Vault_KeePass_DatabaseExample}" />
          <Button x:Name="BrowseDatabaseButton" Grid.Column="1" Content="{x:Static res:Strings.Vault_Browse}" />
        </Grid>
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vault_KeePass_KeyFile}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="KeyFileBox" Classes="mono" PlaceholderText="{x:Static res:Strings.Vault_KeePass_KeyFileExample}" />
          <Button x:Name="BrowseKeyFileButton" Grid.Column="1" Content="{x:Static res:Strings.Vault_Browse}" />
        </Grid>
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vault_KeePass_Entry}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="EntryBox" PlaceholderText="{x:Static res:Strings.Vault_KeePass_EntryExample}" />
          <Button x:Name="PickEntryButton" Grid.Column="1" Content="{x:Static res:Strings.Vault_PickEntry}" />
        </Grid>
      </StackPanel>
      <TextBlock x:Name="KeePassHint" Classes="hint" Margin="1,-4,0,0" />
    </StackPanel>

    <StackPanel x:Name="OnePasswordPanel" Spacing="8" IsVisible="False">
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vault_OnePassword_ReferenceLabel}" />
        <TextBox x:Name="OpReferenceBox" Classes="mono" PlaceholderText="{x:Static res:Strings.Vault_OnePassword_Reference}" />
      </StackPanel>
      <Border x:Name="OnePasswordMissing" Classes="note warning" IsVisible="False">
        <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{x:Static res:Strings.Vault_Err_ToolMissing}" />
      </Border>
      <TextBlock Classes="hint" Margin="1,0,0,0" Text="{x:Static res:Strings.Vault_OnePassword_Hint}" />
    </StackPanel>

    <!-- "Prüfen" reads the secret once and says whether the reference works. -->
    <Grid x:Name="CheckRow" ColumnDefinitions="Auto,Auto,*" IsVisible="False">
      <Button x:Name="CheckButton" Content="{x:Static res:Strings.Vault_Check}" />
      <ui:FASymbolIcon x:Name="CheckIcon" Grid.Column="1" Symbol="Accept" FontSize="14" IsVisible="False" Margin="12,0,-4,0"
                       Foreground="{DynamicResource RmOnlineBrush}" />
      <TextBlock x:Name="CheckText" Grid.Column="2" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>
  </StackPanel>
</UserControl>
