<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RemoteManager.App.Resources"
        xmlns:cred="using:RemoteManager.App.Credentials"
        x:Class="RemoteManager.App.Credentials.KeePassEntryPicker"
        x:DataType="cred:KeePassEntryChoice"
        Title="{x:Static res:Strings.Picker_Title}"
        Width="520" Height="520" MinWidth="380" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <!-- Lists titles, groups, and user names only; passwords are never shown here. -->
  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" x:Name="DatabaseText" Opacity="0.7" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
    <TextBox DockPanel.Dock="Top" x:Name="FilterBox" PlaceholderText="{x:Static res:Strings.Picker_Filter}" Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="SelectButton" Classes="accent" MinWidth="110" IsDefault="True" IsEnabled="False" Content="{x:Static res:Strings.Picker_Select}" />
      <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" Content="{x:Static res:Strings.Action_Cancel}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyText" Opacity="0.6" Text="{x:Static res:Strings.Picker_Empty}" IsVisible="False" />
    <ListBox x:Name="EntryList">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="cred:KeePassEntryChoice">
          <StackPanel Margin="0,2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
