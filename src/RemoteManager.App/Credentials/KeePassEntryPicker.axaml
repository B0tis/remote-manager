<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:res="using:RemoteManager.App.Resources"
        xmlns:cred="using:RemoteManager.App.Credentials"
        x:Class="RemoteManager.App.Credentials.KeePassEntryPicker"
        x:DataType="cred:KeePassEntryChoice"
        Title="{x:Static res:Strings.Picker_Title}"
        Width="540" Height="560" MinWidth="400" MinHeight="340" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RmPanelBrush}">
  <Window.Styles>
    <!-- With the class in the selector: the shared "rows" style sets a padding too, and a selector with a class outranks one without. -->
    <Style Selector="ListBox.rows#EntryList ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
  </Window.Styles>

  <!-- Lists titles, groups, and user names only; passwords are never shown here. -->
  <DockPanel Margin="24,22,24,20">
    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,16">
      <TextBlock Classes="heading" Text="{x:Static res:Strings.Picker_Title}" TextTrimming="CharacterEllipsis" />
      <Grid ColumnDefinitions="*,12,Auto">
        <TextBlock x:Name="DatabaseText" Classes="mono muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock x:Name="CountText" Grid.Column="2" Classes="caption" VerticalAlignment="Center" />
      </Grid>
    </StackPanel>

    <TextBox DockPanel.Dock="Top" x:Name="FilterBox" PlaceholderText="{x:Static res:Strings.Picker_Filter}" Margin="0,0,0,10">
      <TextBox.InnerLeftContent>
        <ui:FASymbolIcon Symbol="Find" FontSize="14" Margin="11,0,0,0" Foreground="{DynamicResource RmTextTertiaryBrush}" />
      </TextBox.InnerLeftContent>
    </TextBox>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="SelectButton" Classes="accent" MinWidth="110" IsDefault="True" IsEnabled="False" Content="{x:Static res:Strings.Picker_Select}" />
      <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" Content="{x:Static res:Strings.Action_Cancel}" />
    </StackPanel>

    <Border Classes="card" ClipToBounds="True">
      <Panel>
        <!-- One entry: what it is called and where it lies; the user name on the right, as it would be typed. -->
        <ListBox x:Name="EntryList" Classes="rows" Margin="6,5">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="cred:KeePassEntryChoice">
              <Grid ColumnDefinitions="*,16,Auto">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Group}" Classes="caption" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Group, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding UserName}" Classes="mono muted" VerticalAlignment="Center"
                           MaxWidth="200" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Classes="muted" Text="{x:Static res:Strings.Picker_Empty}" IsVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>
  </DockPanel>
</Window>
