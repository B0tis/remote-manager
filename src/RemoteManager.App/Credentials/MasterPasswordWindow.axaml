<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Credentials.MasterPasswordWindow"
        Title="{x:Static res:Strings.Unlock_Title}"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RmPanelBrush}">
  <Window.Styles>
    <Style Selector="Grid.facts > TextBlock.factLabel">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.facts > TextBlock.mono">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- Its own top-level window, so it also works above an embedded RDP session (no airspace). -->
  <StackPanel Margin="24,22,24,20" Spacing="16">
    <Grid ColumnDefinitions="Auto,14,*">
      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource RmHoverBrush}" VerticalAlignment="Center">
        <ui:FASymbolIcon Symbol="Permissions" FontSize="18" Foreground="{DynamicResource RmTextSecondaryBrush}" />
      </Border>
      <TextBlock Grid.Column="2" Classes="heading" Text="{x:Static res:Strings.Unlock_Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>

    <!-- Which database is asking, and whether a key file goes with it: file names only, the full path is the tooltip. -->
    <Border Classes="card" Padding="16,12">
      <Grid Classes="facts" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="factLabel" Text="{x:Static res:Strings.Unlock_Database}" />
        <TextBlock x:Name="DatabaseText" Grid.Column="1" Classes="mono" />
        <TextBlock x:Name="KeyFileLabel" Grid.Row="1" Classes="factLabel" Margin="0,8,16,0" Text="{x:Static res:Strings.Unlock_KeyFileLabel}" IsVisible="False" />
        <TextBlock x:Name="KeyFileText" Grid.Row="1" Grid.Column="1" Classes="mono" Margin="0,8,0,0" IsVisible="False" />
      </Grid>
    </Border>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Unlock_Password}" />
      <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton" />
      <Border x:Name="ErrorNote" Classes="note error" Margin="0,8,0,0" IsVisible="False">
        <TextBlock x:Name="ErrorText" Text="{x:Static res:Strings.Unlock_Wrong}" TextWrapping="Wrap" FontSize="12.5" />
      </Border>
      <TextBlock x:Name="HintText" Classes="hint" Margin="1,6,0,0" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,2,0,0">
      <Button x:Name="UnlockButton" Classes="accent" MinWidth="110" IsDefault="True" Content="{x:Static res:Strings.Unlock_Button}" />
      <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" Content="{x:Static res:Strings.Action_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
