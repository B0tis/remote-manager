<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Credentials.MasterPasswordWindow"
        Title="{x:Static res:Strings.Unlock_Title}"
        Width="440" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <!-- Its own top-level window, so it also works above an embedded RDP session (no airspace). -->
  <StackPanel Margin="24" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Border Width="40" Height="40" CornerRadius="10" Background="#16A34A">
        <ui:FASymbolIcon Symbol="Permissions" FontSize="20" Foreground="White" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{x:Static res:Strings.Unlock_Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="DatabaseText" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="330" />
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="KeyFileText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
    <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton"
             PlaceholderText="{x:Static res:Strings.Unlock_Password}" />
    <TextBlock x:Name="ErrorText" Text="{x:Static res:Strings.Unlock_Wrong}" TextWrapping="Wrap" IsVisible="False"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
    <TextBlock x:Name="HintText" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button x:Name="UnlockButton" Classes="accent" MinWidth="110" IsDefault="True" Content="{x:Static res:Strings.Unlock_Button}" />
      <Button x:Name="CancelButton" MinWidth="110" IsCancel="True" Content="{x:Static res:Strings.Action_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
