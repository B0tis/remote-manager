<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vnc="using:RemoteManager.App.Connections.Vnc"
        xmlns:conn="using:RemoteManager.App.Connections"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Connections.Vnc.VncSessionWindow"
        Width="1280" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorationsTheme="{StaticResource RmWindowDecorations}"
        Background="{DynamicResource RmBaseBrush}">
  <!-- One VNC session per window. The view is a normal Avalonia control (no native child window), so
       overlays and menus draw above it. -->
  <DockPanel>
    <conn:SessionBar x:Name="Bar" DockPanel.Dock="Top">
      <conn:SessionBar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="CtrlAltDelButton" Classes="ghost" IsEnabled="False" Padding="9,6" Content="{x:Static res:Strings.Vnc_CtrlAltDel}" />
          <ToggleButton x:Name="ViewOnlyButton" Classes="ghost" Padding="9,6" ToolTip.Tip="{x:Static res:Strings.Vnc_ViewOnlyTip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ui:FASymbolIcon Symbol="View" FontSize="15" />
              <TextBlock Text="{x:Static res:Strings.Vnc_ViewOnly}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ScaleButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Vnc_ScaleTip}">
            <ui:FASymbolIcon Symbol="FullScreenMaximize" FontSize="16" />
          </ToggleButton>
          <Button x:Name="ExternalButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Vnc_OpenExternal}">
            <ui:FASymbolIcon Symbol="NewWindow" FontSize="16" />
          </Button>
          <Button x:Name="DisconnectButton" Classes="ghost" IsEnabled="False" Padding="9,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ui:FASymbolIcon Symbol="Cancel" FontSize="13" />
              <TextBlock Text="{x:Static res:Strings.Session_Disconnect}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </conn:SessionBar.Actions>
    </conn:SessionBar>

    <Grid>
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="False">
        <vnc:VncView x:Name="View" />
      </ScrollViewer>

      <!-- Connect / reconnect card. -->
      <Border x:Name="ConnectCard" Classes="dialogCard" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <conn:ConnectionHeader x:Name="CardHeader" />
          <TextBlock x:Name="DescriptionText" Classes="muted" TextWrapping="Wrap" />
          <!-- Only lives here until Connect; never logged or saved from this window. -->
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_Password}" />
            <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton" />
          </StackPanel>
          <Border Classes="note error" IsVisible="{Binding #CardMessage.IsVisible}">
            <TextBlock x:Name="CardMessage" TextWrapping="Wrap" IsVisible="False" FontSize="12.5" />
          </Border>
          <Grid ColumnDefinitions="*,8,Auto">
            <Button x:Name="ConnectButton" Classes="accent" HorizontalAlignment="Stretch" Height="38"
                    Content="{x:Static res:Strings.Action_Connect}" IsDefault="True" />
            <Button x:Name="CardExternalButton" Grid.Column="2" Height="38" Content="{x:Static res:Strings.Vnc_OpenExternal}" />
          </Grid>
          <TextBlock Classes="hint" Text="{x:Static res:Strings.Vnc_Footer}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
