<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Connections.Vnc.VncSettingsEditor">
  <!-- VNC: picture quality, how the session behaves, and the SSH connection to tunnel through. -->
  <StackPanel Spacing="12">
    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vnc_Quality}" />
      <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" SelectedIndex="0">
        <ComboBoxItem Content="{x:Static res:Strings.Vnc_Quality_Auto}" />
        <ComboBoxItem Content="{x:Static res:Strings.Vnc_Quality_Low}" />
        <ComboBoxItem Content="{x:Static res:Strings.Vnc_Quality_Medium}" />
        <ComboBoxItem Content="{x:Static res:Strings.Vnc_Quality_High}" />
      </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,-4">
      <CheckBox x:Name="ScaleBox" Content="{x:Static res:Strings.Vnc_Settings_Scale}" />
      <CheckBox x:Name="ViewOnlyBox" Content="{x:Static res:Strings.Vnc_Settings_ViewOnly}" />
      <CheckBox x:Name="LivePreviewBox" Content="{x:Static res:Strings.LivePreview_Connection}" IsChecked="True" ToolTip.Tip="{x:Static res:Strings.LivePreview_ConnectionHint}" />
      <CheckBox x:Name="ExternalBox" Content="{x:Static res:Strings.Vnc_Settings_External}" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Vnc_SshTunnel}" />
      <ComboBox x:Name="JumpBox" HorizontalAlignment="Stretch" />
      <TextBlock Classes="hint" Margin="1,6,0,0" Text="{x:Static res:Strings.Vnc_SshTunnelTip}" />
    </StackPanel>
  </StackPanel>
</UserControl>
