<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Connections.Ssh.HostKeyWindow"
        Width="640" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static res:Strings.HostKey_WindowTitle}"
        Background="{DynamicResource RmPanelBrush}">
  <Window.Styles>
    <Style Selector="Grid.facts > TextBlock.factLabel">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="SelectableTextBlock.fingerprint">
      <Setter Property="FontFamily" Value="{StaticResource RmMonoFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- A separate window, not an in-window dialog: the owner may host a native surface (terminal, RDP) that would cover it. -->
  <StackPanel Margin="24,22,24,20" Spacing="16">
    <!-- First contact: a question. -->
    <Grid x:Name="UnknownHeader" ColumnDefinitions="Auto,14,*">
      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource RmHoverBrush}" VerticalAlignment="Top">
        <ui:FASymbolIcon Symbol="Permissions" FontSize="18" Foreground="{DynamicResource RmTextSecondaryBrush}" />
      </Border>
      <StackPanel Grid.Column="2" Spacing="5">
        <TextBlock Classes="heading" Text="{x:Static res:Strings.HostKey_UnknownTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="UnknownText" TextWrapping="Wrap" Foreground="{DynamicResource RmTextSecondaryBrush}" />
      </StackPanel>
    </Grid>

    <!-- The key is not the one this app knows: an alarm, not a question. -->
    <Border x:Name="ChangedHeader" Classes="note error" Padding="16,14,16,16" IsVisible="False">
      <Grid ColumnDefinitions="Auto,14,*">
        <ui:FASymbolIcon Symbol="ImportantFilled" FontSize="26" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Classes="heading" Text="{x:Static res:Strings.HostKey_ChangedTitle}" TextWrapping="Wrap" />
          <TextBlock x:Name="ChangedText" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card" Padding="16,14">
      <Grid Classes="facts" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,10,Auto,10,Auto,6,Auto">
        <TextBlock Classes="factLabel" Text="{x:Static res:Strings.HostKey_Server}" />
        <SelectableTextBlock x:Name="ServerText" Grid.Column="1" Grid.ColumnSpan="2" Classes="mono" TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Classes="factLabel" Text="{x:Static res:Strings.HostKey_Algorithm}" />
        <SelectableTextBlock x:Name="AlgorithmText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="mono" VerticalAlignment="Center" />

        <!-- Unknown key: one fingerprint to check against the server. -->
        <TextBlock x:Name="FingerprintLabel" Grid.Row="4" Classes="factLabel" Text="{x:Static res:Strings.HostKey_Fingerprint}" />
        <SelectableTextBlock x:Name="FingerprintText" Grid.Row="4" Grid.Column="1" Classes="fingerprint" />
        <Button x:Name="CopyButton" Grid.Row="4" Grid.Column="2" Classes="icon" Width="28" Height="28" Margin="8,-4,-6,-4"
                ToolTip.Tip="{x:Static res:Strings.HostKey_CopyFingerprint}">
          <ui:FASymbolIcon Symbol="Copy" FontSize="13" Opacity="0.75" />
        </Button>
      </Grid>
    </Border>

    <!-- Changed key: the known and the new fingerprint right under each other, in one type, so the eye can compare them. -->
    <Border x:Name="CompareCard" Classes="card" Padding="16,12,16,14" IsVisible="False"
            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
      <StackPanel Spacing="8">
        <TextBlock Classes="factLabel" Text="{x:Static res:Strings.HostKey_Fingerprint}" />
        <Grid ColumnDefinitions="Auto,14,*,Auto" RowDefinitions="Auto,8,Auto">
          <TextBlock Text="{x:Static res:Strings.HostKey_Stored}" VerticalAlignment="Center" Foreground="{DynamicResource RmTextSecondaryBrush}" />
          <SelectableTextBlock x:Name="StoredText" Grid.Column="2" Classes="fingerprint" Foreground="{DynamicResource RmTextSecondaryBrush}" />
          <TextBlock Grid.Row="2" Text="{x:Static res:Strings.HostKey_New}" VerticalAlignment="Center" FontWeight="SemiBold" />
          <SelectableTextBlock x:Name="NewText" Grid.Row="2" Grid.Column="2" Classes="fingerprint" FontWeight="SemiBold" />
          <Button x:Name="CopyNewButton" Grid.Row="2" Grid.Column="3" Classes="icon" Width="28" Height="28" Margin="8,-4,-6,-4"
                  ToolTip.Tip="{x:Static res:Strings.HostKey_CopyFingerprint}">
            <ui:FASymbolIcon Symbol="Copy" FontSize="13" Opacity="0.75" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <!-- How to check (unknown), or when to accept at all (changed). -->
    <StackPanel Spacing="4" Margin="1,0">
      <TextBlock x:Name="Advice" Classes="hint" />
      <SelectableTextBlock x:Name="AdviceCommand" Classes="mono" Foreground="{DynamicResource RmTextSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,2,0,0">
      <Button x:Name="AcceptButton" Classes="accent" MinWidth="110" />
      <Button x:Name="CancelButton" MinWidth="110" Content="{x:Static res:Strings.Action_Cancel}" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
