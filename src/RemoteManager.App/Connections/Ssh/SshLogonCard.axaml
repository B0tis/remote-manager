<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conn="using:RemoteManager.App.Connections"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Connections.Ssh.SshLogonCard"
             Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
  <!-- Logon card of the SSH terminal and SFTP windows (shown while no session is open). -->
  <Border Classes="dialogCard">
    <StackPanel Spacing="16">
      <conn:ConnectionHeader x:Name="Header" />
      <!-- "über <Sprunghost>" when the connection goes through a jump host. -->
      <TextBlock x:Name="RouteText" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_User}" />
        <TextBox x:Name="UserBox" />
      </StackPanel>
      <!-- Password or key passphrase: only in this box until Connect, never logged. -->
      <StackPanel IsVisible="{Binding #SecretBox.IsVisible}">
        <TextBlock x:Name="SecretLabel" Classes="fieldLabel" Text="{x:Static res:Strings.Field_Password}" />
        <TextBox x:Name="SecretBox" PasswordChar="●" Classes="revealPasswordButton" />
        <CheckBox x:Name="SaveSecretBox" Margin="0,8,0,0" Content="{x:Static res:Strings.Password_Save}" />
      </StackPanel>
      <TextBlock x:Name="AuthHint" Classes="hint" IsVisible="False" />
      <Border Classes="note error" IsVisible="{Binding #Message.IsVisible}">
        <TextBlock x:Name="Message" TextWrapping="Wrap" IsVisible="False" FontSize="12.5" />
      </Border>
      <Button x:Name="ConnectButton" Classes="accent" HorizontalAlignment="Stretch" Height="38"
              Content="{x:Static res:Strings.Action_Connect}" IsDefault="True" />
    </StackPanel>
  </Border>
</UserControl>
