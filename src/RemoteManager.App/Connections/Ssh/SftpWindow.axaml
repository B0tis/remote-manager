<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:ssh="using:RemoteManager.App.Connections.Ssh"
        xmlns:conn="using:RemoteManager.App.Connections"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Connections.Ssh.SftpWindow"
        Width="980" Height="640" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorationsTheme="{StaticResource RmWindowDecorations}"
        Background="{DynamicResource RmBaseBrush}">
  <DockPanel>
    <conn:SessionBar x:Name="Bar" DockPanel.Dock="Top">
      <conn:SessionBar.Actions>
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button x:Name="ReconnectButton" Classes="ghost" IsVisible="False" Padding="9,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ui:FASymbolIcon Symbol="Refresh" FontSize="14" />
              <TextBlock Text="{x:Static res:Strings.Session_Reconnect}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DisconnectButton" Classes="ghost" IsEnabled="False" Padding="9,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <ui:FASymbolIcon Symbol="Cancel" FontSize="13" />
              <TextBlock Text="{x:Static res:Strings.Session_Disconnect}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </conn:SessionBar.Actions>
    </conn:SessionBar>

    <Grid Background="{DynamicResource RmPanelBrush}">
      <DockPanel x:Name="Browser" IsVisible="False">
        <!-- Where you are, and what you can do there. -->
        <Grid DockPanel.Dock="Top" Margin="12,10,12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="UpButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Sftp_Up}">
              <ui:FASymbolIcon Symbol="Up" FontSize="16" />
            </Button>
            <Button x:Name="HomeButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Sftp_Home}">
              <ui:FASymbolIcon Symbol="Home" FontSize="16" />
            </Button>
            <Button x:Name="RefreshButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Sftp_Refresh}">
              <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
            </Button>
          </StackPanel>
          <TextBox x:Name="PathBox" Grid.Column="1" Classes="mono" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button x:Name="UploadButton" Classes="accent" Padding="11,6" ToolTip.Tip="{x:Static res:Strings.Sftp_UploadTip}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ui:FASymbolIcon Symbol="Upload" FontSize="15" />
                <TextBlock Text="{x:Static res:Strings.Sftp_Upload}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="DownloadButton" Classes="ghost" Padding="9,6" Margin="4,0,0,0" IsEnabled="False" ToolTip.Tip="{x:Static res:Strings.Sftp_DownloadTip}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <ui:FASymbolIcon Symbol="Download" FontSize="15" />
                <TextBlock Text="{x:Static res:Strings.Sftp_Download}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NewFolderButton" Classes="icon" ToolTip.Tip="{x:Static res:Strings.Sftp_NewFolder}">
              <ui:FASymbolIcon Symbol="NewFolder" FontSize="16" />
            </Button>
            <Button x:Name="RenameButton" Classes="icon" IsEnabled="False" ToolTip.Tip="{x:Static res:Strings.Sftp_Rename}">
              <ui:FASymbolIcon Symbol="Rename" FontSize="16" />
            </Button>
            <Button x:Name="DeleteButton" Classes="icon" IsEnabled="False" ToolTip.Tip="{x:Static res:Strings.Action_Delete}">
              <ui:FASymbolIcon Symbol="Delete" FontSize="16" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Transfer progress -->
        <Border x:Name="TransferBar" DockPanel.Dock="Bottom" Padding="16,9" IsVisible="False" BorderThickness="0,1,0,0"
                Background="{DynamicResource RmCardBrush}" BorderBrush="{DynamicResource RmStrokeBrush}">
          <Grid ColumnDefinitions="*,12,240,12,Auto">
            <TextBlock x:Name="TransferText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="TransferProgress" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center" />
            <Button x:Name="CancelTransferButton" Grid.Column="4" Classes="ghost" Content="{x:Static res:Strings.Action_Cancel}" />
          </Grid>
        </Border>

        <Grid>
          <DockPanel>
            <Border DockPanel.Dock="Top" Margin="12,0,12,2" Padding="12,0,12,7" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource RmStrokeBrush}">
              <Grid ColumnDefinitions="28,*,110,160,110">
                <TextBlock Grid.Column="1" Classes="caption" Text="{x:Static res:Strings.Column_Name}" />
                <TextBlock Grid.Column="2" Classes="caption" Text="{x:Static res:Strings.Sftp_Size}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Classes="caption" Text="{x:Static res:Strings.Sftp_Modified}" />
                <TextBlock Grid.Column="4" Classes="caption" Text="{x:Static res:Strings.Sftp_Permissions}" />
              </Grid>
            </Border>
            <ListBox x:Name="Entries" Classes="rows" SelectionMode="Multiple" Margin="12,0,12,10" DragDrop.AllowDrop="True">
              <ListBox.ContextMenu>
                <ContextMenu x:Name="EntriesMenu">
                  <MenuItem x:Name="MenuOpen" Header="{x:Static res:Strings.Sftp_Open}" />
                  <MenuItem x:Name="MenuDownload" Header="{x:Static res:Strings.Sftp_DownloadEllipsis}" />
                  <MenuItem x:Name="MenuRename" Header="{x:Static res:Strings.Sftp_RenameEllipsis}" />
                  <MenuItem x:Name="MenuDelete" Header="{x:Static res:Strings.Action_DeleteEllipsis}" />
                  <Separator />
                  <MenuItem x:Name="MenuCopyPath" Header="{x:Static res:Strings.Sftp_CopyPath}" />
                  <MenuItem x:Name="MenuNewFolder" Header="{x:Static res:Strings.Sftp_NewFolderEllipsis}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="ssh:SftpItem">
                  <Grid ColumnDefinitions="28,*,110,160,110" Height="34" Background="Transparent">
                    <ui:FASymbolIcon Symbol="{Binding Symbol}" FontSize="16" HorizontalAlignment="Left" Foreground="{Binding IconBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding SizeLabel}" FontSize="12.5" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="muted" Text="{Binding ModifiedLabel}" FontSize="12.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Classes="mono faint" Text="{Binding Entry.Permissions}" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <TextBlock x:Name="EmptyText" Classes="caption" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"
                     Text="{x:Static res:Strings.Sftp_Empty}" IsHitTestVisible="False" />
          <!-- Shown while files are dragged over the list. -->
          <Border x:Name="DropHint" IsVisible="False" IsHitTestVisible="False" Margin="12,30,12,10" CornerRadius="{StaticResource RmRadiusCard}"
                  BorderThickness="2" BorderBrush="{DynamicResource RmAccentBrush}" Background="{DynamicResource RmAccentSoftBrush}">
            <TextBlock x:Name="DropHintText" Classes="subtitle" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </DockPanel>

      <ssh:SshLogonCard x:Name="Card" />
    </Grid>
  </DockPanel>
</Window>
