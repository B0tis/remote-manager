<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Connections.RemoteTools.RemoteToolsDialog"
             Width="500">
  <UserControl.Styles>
    <Style Selector="Border.topic">
      <Setter Property="Padding" Value="16,14,16,16" />
    </Style>
    <Style Selector="Border.topic TextBlock.intro">
      <Setter Property="Margin" Value="0,4,0,12" />
    </Style>
  </UserControl.Styles>

  <!-- Three topics, a card each. The dialog scrolls as a whole when the window is low. -->
  <StackPanel Spacing="12">
    <!-- Tool paths: detected automatically; a path set here wins. The lamp shows whether the tool can start. -->
    <Border Classes="card topic">
      <StackPanel>
        <TextBlock Classes="section" Text="{x:Static res:Strings.RemoteTool_Paths_Title}" />
        <TextBlock Classes="hint intro" Text="{x:Static res:Strings.RemoteTool_Paths_Hint}" />
        <StackPanel x:Name="PathRows" Spacing="14" />
      </StackPanel>
    </Border>

    <!-- TeamViewer Web API -->
    <Border Classes="card topic">
      <StackPanel>
        <TextBlock Classes="section" Text="{x:Static res:Strings.RemoteTool_Sync_Title}" />
        <TextBlock Classes="hint intro" Text="{x:Static res:Strings.RemoteTool_Sync_Hint}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Token_Label}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,1,5">
            <Ellipse x:Name="TokenLamp" Classes="lamp idle" Width="7" Height="7" />
            <TextBlock x:Name="TokenState" Classes="caption" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
          <TextBox x:Name="TokenBox" PasswordChar="●" Classes="revealPasswordButton" />
          <Button x:Name="SaveTokenButton" Grid.Column="2" Content="{x:Static res:Strings.RemoteTool_Sync_SaveToken}" />
          <Button x:Name="DeleteTokenButton" Grid.Column="4" Content="{x:Static res:Strings.Action_Remove}" />
        </Grid>
        <Button x:Name="SyncButton" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Sync" FontSize="14" />
            <TextBlock Text="{x:Static res:Strings.RemoteTool_Sync_Now}" />
          </StackPanel>
        </Button>
        <ui:FAInfoBar x:Name="SyncResult" IsOpen="False" IsClosable="False" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <!-- AnyDesk CSV -->
    <Border Classes="card topic">
      <StackPanel>
        <TextBlock Classes="section" Text="{x:Static res:Strings.RemoteTool_Csv_Title}" />
        <TextBlock Classes="hint intro" Text="{x:Static res:Strings.RemoteTool_Csv_Hint}" />
        <Button x:Name="CsvButton">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Import" FontSize="14" />
            <TextBlock Text="{x:Static res:Strings.RemoteTool_Csv_Import}" />
          </StackPanel>
        </Button>
        <ui:FAInfoBar x:Name="CsvResult" IsOpen="False" IsClosable="False" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
