<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Connections.RemoteTools.RemoteToolSettingsEditor">
  <!-- Start options of TeamViewer, AnyDesk, or RustDesk: what the tool really has, free arguments, the resulting call. -->
  <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Alias}" />
        <TextBox x:Name="AliasBox" PlaceholderText="{x:Static res:Strings.RemoteTool_AliasPlaceholder}" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Mode}" />
        <!-- Filled with the modes of the tool (RemoteToolCommandLine.ModesOf). -->
        <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Grid>

    <!-- TeamViewer: -q and -a -->
    <Grid x:Name="TeamViewerRow" ColumnDefinitions="*,*" ColumnSpacing="12">
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Quality}" />
        <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Access}" />
        <ComboBox x:Name="AccessBox" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Grid>

    <!-- AnyDesk: full screen and plain window -->
    <UniformGrid x:Name="AnyDeskRow" Columns="2" Margin="0,-4">
      <CheckBox x:Name="FullScreenBox" Content="{x:Static res:Strings.RemoteTool_FullScreen}" />
      <CheckBox x:Name="PlainBox" Content="{x:Static res:Strings.RemoteTool_Plain}" />
    </UniformGrid>

    <!-- Password on the command line (TeamViewer, RustDesk): off by default, warns when on. -->
    <StackPanel Spacing="6">
      <CheckBox x:Name="PasswordOnLineBox" Margin="0,-4" />
      <Border x:Name="PasswordWarning" Classes="note warning" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <ui:FASymbolIcon Symbol="ImportantFilled" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static res:Strings.RemoteTool_PasswordWarning_Title}" />
            <TextBlock x:Name="PasswordWarningText" FontSize="12.5" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock x:Name="PasswordInfo" Classes="hint" Margin="1,0,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Arguments}" />
      <TextBox x:Name="ArgumentsBox" Classes="mono" PlaceholderText="{x:Static res:Strings.RemoteTool_ArgumentsPlaceholder}" />
      <TextBlock Classes="hint" Margin="1,6,0,0" Text="{x:Static res:Strings.RemoteTool_Hint}" />
    </StackPanel>

    <!-- The call as it will run, with the password masked. -->
    <StackPanel>
      <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.RemoteTool_Preview}" />
      <Border Classes="well" Padding="12,9">
        <SelectableTextBlock x:Name="PreviewText" Classes="mono" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
