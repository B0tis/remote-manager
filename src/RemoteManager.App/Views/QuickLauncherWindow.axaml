<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:app="using:RemoteManager.App.Views"
        xmlns:res="using:RemoteManager.App.Resources"
        x:Class="RemoteManager.App.Views.QuickLauncherWindow"
        Title="{x:Static res:Strings.Launcher_Title}"
        Width="640" SizeToContent="Height" CanResize="False"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Border Padding="14,14,14,10">
    <StackPanel Spacing="10">
      <TextBox x:Name="QueryBox" FontSize="18" Padding="12,10" PlaceholderText="{x:Static res:Strings.Launcher_Placeholder}">
        <TextBox.InnerLeftContent>
          <ui:FASymbolIcon Symbol="Find" FontSize="18" Margin="12,0,0,0" Opacity="0.6" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <ListBox x:Name="ResultList" MaxHeight="420" Background="Transparent" Classes="launcher">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:ConnectionItem">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="46">
              <Border Width="34" Height="34" CornerRadius="17" Background="{Binding TypeBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding TypeInitials}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTip}" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <ui:FASymbolIcon Symbol="StarFilled" FontSize="12" Foreground="#F59E0B" IsVisible="{Binding IsFavorite}" />
                </StackPanel>
                <TextBlock Text="{Binding HostLabel}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding GroupPath}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                <Border Classes="pill" Background="{Binding TypeBrush}">
                  <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock x:Name="NoResults" Text="{x:Static res:Strings.Empty_NoMatch}" Opacity="0.55" Margin="4,6" IsVisible="False" />

      <Grid ColumnDefinitions="*,Auto" Opacity="0.75">
        <TextBlock Text="{x:Static res:Strings.Launcher_Hints}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <TextBlock x:Name="HotkeyText" FontSize="12" VerticalAlignment="Center" />
          <Button x:Name="ChangeHotkeyButton" Classes="toolbar" Padding="8,2" FontSize="12" Content="{x:Static res:Strings.Launcher_ChangeHotkey}" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</Window>
