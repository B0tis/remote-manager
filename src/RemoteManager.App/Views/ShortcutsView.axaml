<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:RemoteManager.App.Views"
             x:Class="RemoteManager.App.Views.ShortcutsView"
             Width="760">
  <UserControl.Styles>
    <!-- Key caps a size up from the ones in the title bar: here they are the content, not a remark. -->
    <Style Selector="Border.keycap">
      <Setter Property="Padding" Value="7,2,7,3" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource RmTextBrush}" />
    </Style>
    <Style Selector="TextBlock.join">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource RmTextTertiaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One area: its name, then the shortcuts as lines of a card. -->
    <DataTemplate x:DataType="app:ShortcutArea">
      <StackPanel Spacing="8" Margin="0,0,0,20">
        <TextBlock Classes="section" Text="{Binding Title}" HorizontalAlignment="Left" Margin="2,0,0,0" />
        <Border Classes="card" Padding="14,3">
          <ItemsControl ItemsSource="{Binding Rows}" />
        </Border>
        <TextBlock Classes="hint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" Margin="2,0,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:DataType="app:ShortcutRow">
      <Border BorderBrush="{DynamicResource RmStrokeBrush}" BorderThickness="{Binding Divider}" MinHeight="37">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Border Classes="typeChip" Background="{Binding ChipBrush}" IsVisible="{Binding HasChip}" MinWidth="44"
                  Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Chip}" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                     Margin="0,7,12,8" />
          <ItemsControl Grid.Column="2" ItemsSource="{Binding Parts}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="app:ShortcutPart">
                <Panel>
                  <Border Classes="keycap" IsVisible="{Binding IsKey}">
                    <TextBlock Text="{Binding Text}" />
                  </Border>
                  <TextBlock Classes="join" Text="{Binding Text}" IsVisible="{Binding IsJoin}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- Two columns: the overview and its connections on the left, launcher and sessions on the right. -->
  <Grid ColumnDefinitions="*,24,*">
    <ItemsControl x:Name="LeftColumn" />
    <ItemsControl x:Name="RightColumn" Grid.Column="2" />
  </Grid>
</UserControl>
