<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             xmlns:cred="using:RemoteManager.App.Credentials"
             x:Class="RemoteManager.App.Views.GroupEditor"
             Width="480">
  <!-- Same form language as the connection editor: sections, a label above every input, the password as one unit. -->
  <StackPanel>
    <Grid Classes="sectionHead first" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.GroupEditor_Section}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_Name}" />
          <TextBox x:Name="NameBox" PlaceholderText="{x:Static res:Strings.GroupEditor_NameExample}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.GroupEditor_Parent}" />
          <ComboBox x:Name="ParentBox" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Grid>
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_Description}" />
        <TextBox x:Name="DescriptionBox" PlaceholderText="{x:Static res:Strings.GroupEditor_DescriptionExample}" />
      </StackPanel>
    </StackPanel>

    <Grid Classes="sectionHead" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.GroupEditor_Logon}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <StackPanel Spacing="12">
      <TextBlock Classes="hint" Margin="1,-4,0,0" Text="{x:Static res:Strings.GroupEditor_LogonHint}" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_User}" />
          <TextBox x:Name="UserBox" PlaceholderText="{x:Static res:Strings.Editor_UserExample}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_DomainOptional}" />
          <TextBox x:Name="DomainBox" PlaceholderText="{x:Static res:Strings.Editor_DomainExample}" />
        </StackPanel>
      </Grid>

      <!-- The group password: the app's own (Credential Manager), a KeePass entry, or a 1Password item.
           Like the connection editor: the stored password is never read back, the box only takes a new one. -->
      <Border Classes="well">
        <StackPanel Spacing="12">
          <cred:PasswordSourcePanel x:Name="SourcePanel" />
          <StackPanel x:Name="OwnPasswordPanel" Spacing="8">
            <Grid x:Name="StoredRow" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
              <ui:FASymbolIcon x:Name="StoredIcon" Symbol="Permissions" FontSize="14" Margin="1,0,8,0"
                               Foreground="{DynamicResource RmOnlineBrush}" />
              <TextBlock x:Name="StoredText" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Text="{x:Static res:Strings.Password_Stored}" />
              <Button x:Name="RemovePasswordButton" Grid.Column="2" Classes="link" Content="{x:Static res:Strings.Action_Remove}" />
            </Grid>
            <StackPanel>
              <TextBlock x:Name="PasswordLabel" Classes="fieldLabel" Text="{x:Static res:Strings.Field_Password}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton" />
                <CheckBox x:Name="SavePasswordBox" Grid.Column="1" Content="{x:Static res:Strings.Password_Save}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border x:Name="ErrorNote" Classes="note error" Margin="0,16,0,0" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <ui:FASymbolIcon Symbol="ImportantFilled" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
