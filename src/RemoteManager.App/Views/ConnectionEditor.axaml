<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             xmlns:cred="using:RemoteManager.App.Credentials"
             xmlns:views="using:RemoteManager.App.Views"
             x:Class="RemoteManager.App.Views.ConnectionEditor"
             Width="520">
  <!--
    Sections top to bottom: Verbindung, Einordnung, Anmeldung, Startparameter (the type's own editor), Notizen.
    Every input has its label above it; a placeholder only gives an example. Fields sit on a grid of four
    equal columns (12 px apart), so the inner edges of all rows line up.
  -->
  <StackPanel>
    <Grid Classes="sectionHead first" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.Editor_Section_Connection}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
      <StackPanel Grid.ColumnSpan="2">
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_Name}" />
        <TextBox x:Name="NameBox" PlaceholderText="{x:Static res:Strings.Editor_NameExample}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Grid.ColumnSpan="2">
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Editor_Type}" />
        <!-- One entry per connection handler: its plate (initials on the type's color) and its name. -->
        <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="views:ConnectionTypeChoice">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="typeChip" Background="{Binding Brush}" Width="40" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel x:Name="HostField" Grid.Row="1" Grid.ColumnSpan="3">
        <TextBlock x:Name="HostLabel" Classes="fieldLabel" />
        <TextBox x:Name="HostBox" Classes="mono" />
      </StackPanel>
      <StackPanel x:Name="PortField" Grid.Row="1" Grid.Column="3">
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Editor_Port}" />
        <TextBox x:Name="PortBox" Classes="mono" />
      </StackPanel>
    </Grid>

    <Grid Classes="sectionHead" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.Editor_Section_Organize}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <StackPanel Spacing="12">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel>
            <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Editor_Group}" />
            <AutoCompleteBox x:Name="GroupBox" PlaceholderText="{x:Static res:Strings.Editor_GroupExample}" FilterMode="Contains" MinimumPrefixLength="0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Editor_Tags}" />
            <TextBox x:Name="TagsBox" PlaceholderText="{x:Static res:Strings.Editor_TagsExample}" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="hint" Margin="1,0,0,0" Text="{x:Static res:Strings.Editor_OrganizeHint}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_Description}" />
        <TextBox x:Name="DescriptionBox" PlaceholderText="{x:Static res:Strings.Editor_DescriptionExample}" />
      </StackPanel>
      <CheckBox x:Name="FavoriteBox" Content="{x:Static res:Strings.Editor_Favorite}" Margin="0,-4,0,-4" />
    </StackPanel>

    <Grid Classes="sectionHead" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.Editor_Logon}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <StackPanel Spacing="12">
      <Grid x:Name="UserRow" ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_User}" />
          <TextBox x:Name="UserBox" PlaceholderText="{x:Static res:Strings.Editor_UserExample}" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="fieldLabel" Text="{x:Static res:Strings.Field_DomainOptional}" />
          <TextBox x:Name="DomainBox" PlaceholderText="{x:Static res:Strings.Editor_DomainExample}" />
        </StackPanel>
      </Grid>

      <!-- Which group logon applies (inherited or replaced by the own one), and the group's logon in a flyout. -->
      <Border x:Name="GroupLogonNote" Classes="note" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <ui:FASymbolIcon Symbol="People" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0"
                           Foreground="{DynamicResource RmTextSecondaryBrush}" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock x:Name="InheritedHint" Classes="hint" IsVisible="False" />
            <TextBlock x:Name="NoGroupLogonHint" Classes="hint" IsVisible="False" />
            <!-- The link's own padding is taken back, so its text starts on the edge of the lines above. -->
            <Button x:Name="GroupLogonButton" Classes="link" HorizontalAlignment="Left" Margin="-6,0,0,-2"
                    Content="{x:Static res:Strings.Editor_GroupLogonButton}" IsVisible="False" />
          </StackPanel>
        </Grid>
      </Border>

      <!--
        The password as one unit: where it comes from (own password in the Credential Manager, a KeePass entry,
        a 1Password item) and, for the own one, the box that takes a new value. The stored password is never
        read back into this dialog.
      -->
      <Border Classes="well">
        <StackPanel Spacing="12">
          <cred:PasswordSourcePanel x:Name="SourcePanel" />
          <StackPanel x:Name="OwnPasswordPanel" Spacing="8">
            <Grid x:Name="StoredRow" ColumnDefinitions="Auto,*,Auto" IsVisible="False">
              <ui:FASymbolIcon x:Name="StoredIcon" Symbol="Permissions" FontSize="14" Margin="1,0,8,0"
                               Foreground="{DynamicResource RmOnlineBrush}" />
              <TextBlock x:Name="StoredText" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Text="{x:Static res:Strings.Password_Stored}" />
              <Button x:Name="RemovePasswordButton" Grid.Column="2" Classes="link" Content="{x:Static res:Strings.Action_Remove}" />
            </Grid>
            <StackPanel>
              <TextBlock x:Name="PasswordLabel" Classes="fieldLabel" Text="{x:Static res:Strings.Field_Password}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox x:Name="PasswordBox" PasswordChar="●" Classes="revealPasswordButton" />
                <CheckBox x:Name="SavePasswordBox" Grid.Column="1" Content="{x:Static res:Strings.Password_Save}" />
              </Grid>
            </StackPanel>
            <TextBlock x:Name="PasswordHint" Classes="hint" Margin="1,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Type-specific options: the handler's ISettingsEditor. -->
    <Grid x:Name="SettingsHead" Classes="sectionHead" ColumnDefinitions="Auto,*">
      <TextBlock Classes="section" Text="{x:Static res:Strings.Editor_Section_StartParameters}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <ContentControl x:Name="SettingsHost" />

    <Grid Classes="sectionHead" ColumnDefinitions="Auto,*">
      <TextBlock x:Name="NotesHeading" Classes="section" Text="{x:Static res:Strings.Field_Notes}" />
      <Border Grid.Column="1" Classes="rule" />
    </Grid>
    <TextBox x:Name="NotesBox" PlaceholderText="{x:Static res:Strings.Editor_NotesExample}" AcceptsReturn="True" TextWrapping="Wrap"
             MinHeight="72" MaxHeight="160" />

    <Border x:Name="ErrorNote" Classes="note error" Margin="0,16,0,0" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <ui:FASymbolIcon Symbol="ImportantFilled" FontSize="15" VerticalAlignment="Top" Margin="0,2,0,0"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
