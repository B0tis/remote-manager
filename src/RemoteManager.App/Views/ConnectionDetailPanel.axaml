<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ctl="using:RemoteManager.App.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Views.ConnectionDetailPanel">
  <UserControl.Styles>
    <Style Selector="Grid.properties > TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource RmTextTertiaryBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,0,12,9" />
    </Style>
    <Style Selector="Grid.properties > :is(TextBlock).value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
  </UserControl.Styles>
  <!-- A column next to the tiles or list, never an overlay (airspace: sessions are native windows). -->
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="18,14,8,4">
      <TextBlock Text="{x:Static res:Strings.Details_Title}" Classes="caption" VerticalAlignment="Center" />
      <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Width="30" Height="30" ToolTip.Tip="{x:Static res:Strings.Details_HideTip}">
        <ui:FASymbolIcon Symbol="Dismiss" FontSize="11" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="18,0,18,18">
        <!-- Nothing selected -->
        <StackPanel x:Name="EmptyView" Spacing="10" Margin="0,56,0,0" HorizontalAlignment="Center">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource RmHoverBrush}" HorizontalAlignment="Center">
            <ui:FASymbolIcon Symbol="DockRight" FontSize="24" Opacity="0.5" />
          </Border>
          <TextBlock Text="{x:Static res:Strings.Details_Empty}" Classes="caption" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="230" />
        </StackPanel>

        <!-- One connection -->
        <StackPanel x:Name="SingleView" Spacing="16" IsVisible="False">
          <Border Height="158" CornerRadius="{StaticResource RmRadiusCard}" ClipToBounds="True"
                  BorderBrush="{DynamicResource RmStrokeBrush}" BorderThickness="1">
            <Grid>
              <Border x:Name="PreviewBackground" />
              <ctl:HostGlyph x:Name="PreviewGlyph" Margin="8,6" />
              <Image x:Name="PreviewImage" Stretch="UniformToFill" />
              <Border x:Name="PreviewShade" Classes="previewShade" />
              <Border Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse x:Name="StatusDot" Classes="lamp" />
                  <TextBlock x:Name="StatusPillText" />
                </StackPanel>
              </Border>
              <Border x:Name="TypeChip" Classes="typeChip" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9">
                <TextBlock x:Name="TypeChipText" />
              </Border>
              <Border x:Name="LiveBadge" Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"
                      IsVisible="False" ToolTip.Tip="{x:Static res:Strings.LivePreview_BadgeTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Classes="lamp" Fill="{DynamicResource RmLiveBrush}" />
                  <TextBlock Text="{x:Static res:Strings.LivePreview_Badge}" FontWeight="SemiBold" />
                  <TextBlock x:Name="LiveAgeText" Opacity="0.8" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock x:Name="NameText" Classes="heading" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button x:Name="FavoriteButton" Grid.Column="1" Classes="icon" VerticalAlignment="Top">
                <Panel>
                  <ui:FASymbolIcon x:Name="FavoriteOn" Symbol="StarFilled" FontSize="17" Foreground="{DynamicResource FavoriteBrush}" />
                  <ui:FASymbolIcon x:Name="FavoriteOff" Symbol="Star" FontSize="17" Opacity="0.6" />
                </Panel>
              </Button>
            </Grid>
            <TextBlock x:Name="SubtitleText" Classes="muted" TextWrapping="Wrap" />
            <ItemsControl x:Name="TagList" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="tag" Margin="0,0,5,5">
                    <TextBlock Text="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- The one thing this panel is for, then the two things done next most often. -->
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <Button x:Name="ConnectButton" Classes="accent" Height="36" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Play" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_Connect}" />
              </StackPanel>
            </Button>
            <Button x:Name="EditButton" Grid.Column="1" Height="36" Width="40" Padding="0" ToolTip.Tip="{x:Static res:Strings.Action_Edit}">
              <ui:FASymbolIcon Symbol="Edit" FontSize="15" />
            </Button>
            <Button x:Name="CopyPasswordButton" Grid.Column="2" Height="36" Width="40" Padding="0" ToolTip.Tip="{x:Static res:Strings.Action_CopyPassword}">
              <ui:FASymbolIcon Symbol="Permissions" FontSize="15" />
            </Button>
          </Grid>

          <!-- Answer time of the last status checks; only for types whose check measures one. -->
          <Border x:Name="LatencyCard" Classes="card" Padding="14,10,14,12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static res:Strings.Details_AnswerTime}" Classes="caption" VerticalAlignment="Center" />
              <TextBlock x:Name="LatencyText" Grid.Column="1" Classes="display" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ctl:Sparkline x:Name="LatencyLine" Grid.Row="1" Grid.ColumnSpan="2" Height="34" Margin="0,8,0,0"
                             Stroke="{DynamicResource RmOnlineBrush}" GapBrush="{DynamicResource RmOfflineBrush}" />
            </Grid>
          </Border>

          <Grid x:Name="PropertyGrid" ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Classes="properties">
            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Details_Host}" Classes="label" VerticalAlignment="Center" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,-3,0,5">
              <SelectableTextBlock x:Name="HostText" Classes="mono" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button x:Name="CopyHostButton" Grid.Column="1" Classes="icon" Width="26" Height="26" ToolTip.Tip="{x:Static res:Strings.Details_CopyHost}">
                <ui:FASymbolIcon Symbol="Copy" FontSize="12" Opacity="0.7" />
              </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Details_User}" Classes="label" />
            <TextBlock x:Name="UserText" Grid.Row="1" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Column_Group}" Classes="label" />
            <TextBlock x:Name="GroupText" Grid.Row="2" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Details_Status}" Classes="label" />
            <TextBlock x:Name="StatusText" Grid.Row="3" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Column_LastConnected}" Classes="label" />
            <TextBlock x:Name="LastConnectedText" Grid.Row="4" Grid.Column="1" Classes="value" />
          </Grid>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static res:Strings.Details_StartParameters}" Classes="section" />
              <Button x:Name="EditParametersButton" Grid.Column="1" Classes="link" Content="{x:Static res:Strings.Details_Change}" />
            </Grid>
            <ItemsControl x:Name="ParameterList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Classes="muted" FontSize="12.5" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="7">
            <TextBlock Text="{x:Static res:Strings.Field_Notes}" Classes="section" />
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="240"
                     PlaceholderText="{x:Static res:Strings.Details_NotesPlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:Strings.Details_History}" Classes="section" />
            <TextBlock x:Name="HistoryEmpty" Text="{x:Static res:Strings.Details_HistoryEmpty}" Classes="caption" />
            <ItemsControl x:Name="HistoryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,3">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource RmStrokeStrongBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding}" Classes="muted" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Several connections -->
        <StackPanel x:Name="MultiView" Spacing="14" IsVisible="False">
          <TextBlock x:Name="MultiTitle" Classes="heading" TextWrapping="Wrap" />
          <ItemsControl x:Name="MultiList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="muted" Margin="0,2" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="8">
            <Button x:Name="ConnectAllButton" Classes="accent" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Play" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_ConnectAll}" />
              </StackPanel>
            </Button>
            <Button x:Name="FavoriteAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Star" FontSize="14" />
                <TextBlock x:Name="FavoriteAllText" />
              </StackPanel>
            </Button>
            <Button x:Name="MoveAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="MoveToFolder" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_MoveToGroup}" />
              </StackPanel>
            </Button>
            <Button x:Name="DeleteAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Delete" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_DeleteEllipsis}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
