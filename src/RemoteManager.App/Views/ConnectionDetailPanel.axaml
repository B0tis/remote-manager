<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:res="using:RemoteManager.App.Resources"
             x:Class="RemoteManager.App.Views.ConnectionDetailPanel">
  <UserControl.Styles>
    <Style Selector="Grid.properties > TextBlock.label">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="0,0,12,8" />
    </Style>
    <Style Selector="Grid.properties > :is(TextBlock).value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
  </UserControl.Styles>
  <!-- A column next to the tiles or list, never an overlay (airspace: sessions are native windows). -->
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="18,18,10,6">
      <TextBlock Text="{x:Static res:Strings.Details_Title}" FontSize="13" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" />
      <Button x:Name="CloseButton" Grid.Column="1" Classes="toolbar" Padding="6" ToolTip.Tip="{x:Static res:Strings.Details_HideTip}">
        <ui:FASymbolIcon Symbol="Dismiss" FontSize="12" />
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Panel Margin="18,0,18,18">
        <!-- Nothing selected -->
        <StackPanel x:Name="EmptyView" Spacing="8" Margin="0,40,0,0" HorizontalAlignment="Center">
          <ui:FASymbolIcon Symbol="DockRight" FontSize="32" Opacity="0.35" />
          <TextBlock Text="{x:Static res:Strings.Details_Empty}" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
        </StackPanel>

        <!-- One connection -->
        <StackPanel x:Name="SingleView" Spacing="14" IsVisible="False">
          <Border Height="168" CornerRadius="8" ClipToBounds="True">
            <Grid>
              <Border x:Name="PreviewBackground" Opacity="0.14" />
              <Border x:Name="PreviewIcon" Width="72" Height="72" CornerRadius="36">
                <TextBlock x:Name="PreviewInitials" Foreground="White" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Image x:Name="PreviewImage" Stretch="UniformToFill" />
              <Border x:Name="LiveBadge" Classes="pill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                      IsVisible="False" ToolTip.Tip="{x:Static res:Strings.LivePreview_BadgeTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Static res:Strings.LivePreview_Badge}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                  <TextBlock x:Name="LiveAgeText" FontSize="11" Foreground="White" Opacity="0.8" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Button x:Name="FavoriteButton" Grid.Column="1" Classes="toolbar" Padding="6" VerticalAlignment="Top">
                <Panel>
                  <ui:FASymbolIcon x:Name="FavoriteOn" Symbol="StarFilled" FontSize="18" Foreground="#F59E0B" />
                  <ui:FASymbolIcon x:Name="FavoriteOff" Symbol="Star" FontSize="18" Opacity="0.6" />
                </Panel>
              </Button>
            </Grid>
            <TextBlock x:Name="SubtitleText" Opacity="0.7" TextWrapping="Wrap" />
            <ItemsControl x:Name="TagList" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="tag" Margin="0,0,6,6">
                    <TextBlock Text="{Binding}" FontSize="11" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <WrapPanel>
            <Button x:Name="ConnectButton" Classes="accent" Padding="12,6" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Play" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_Connect}" />
              </StackPanel>
            </Button>
            <Button x:Name="EditButton" Padding="12,6" Margin="0,0,8,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Edit" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_Edit}" />
              </StackPanel>
            </Button>
            <Button x:Name="CopyPasswordButton" Padding="12,6" Margin="0,0,8,8" ToolTip.Tip="{x:Static res:Strings.Action_CopyPassword}">
              <ui:FASymbolIcon Symbol="Permissions" FontSize="14" />
            </Button>
          </WrapPanel>

          <Grid x:Name="PropertyGrid" ColumnDefinitions="134,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Classes="properties">
            <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Details_Host}" Classes="label" />
            <SelectableTextBlock x:Name="HostText" Grid.Row="0" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Details_User}" Classes="label" />
            <TextBlock x:Name="UserText" Grid.Row="1" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Column_Group}" Classes="label" />
            <TextBlock x:Name="GroupText" Grid.Row="2" Grid.Column="1" Classes="value" />
            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Details_Status}" Classes="label" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
              <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Column_LastConnected}" Classes="label" />
            <TextBlock x:Name="LastConnectedText" Grid.Row="4" Grid.Column="1" Classes="value" />
          </Grid>

          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static res:Strings.Details_StartParameters}" Classes="section" />
              <Button x:Name="EditParametersButton" Grid.Column="1" Classes="link" Content="{x:Static res:Strings.Details_Change}" />
            </Grid>
            <ItemsControl x:Name="ParameterList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Opacity="0.8" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:Strings.Field_Notes}" Classes="section" />
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="240"
                     PlaceholderText="{x:Static res:Strings.Details_NotesPlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:Strings.Details_History}" Classes="section" />
            <TextBlock x:Name="HistoryEmpty" Text="{x:Static res:Strings.Details_HistoryEmpty}" Opacity="0.55" />
            <ItemsControl x:Name="HistoryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" Opacity="0.8" FontSize="12" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <!-- Several connections -->
        <StackPanel x:Name="MultiView" Spacing="12" IsVisible="False">
          <TextBlock x:Name="MultiTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ItemsControl x:Name="MultiList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Opacity="0.75" Margin="0,1" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="8">
            <Button x:Name="ConnectAllButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Play" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_ConnectAll}" />
              </StackPanel>
            </Button>
            <Button x:Name="FavoriteAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Star" FontSize="14" />
                <TextBlock x:Name="FavoriteAllText" />
              </StackPanel>
            </Button>
            <Button x:Name="MoveAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="MoveToFolder" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_MoveToGroup}" />
              </StackPanel>
            </Button>
            <Button x:Name="DeleteAllButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:FASymbolIcon Symbol="Delete" FontSize="14" />
                <TextBlock Text="{x:Static res:Strings.Action_DeleteEllipsis}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
